{
  // ============ 核心 / 全局 ============
  "coc.preferences": {
    "timeout": 500,
    "useQuickfixForLocations": false,
    "colorSupport": false,
    "extensionUpdateCheck": "weekly",
    "messageLevel": "error",
    "listOfWorkspaceEdit": "location",
    "hoverTarget": "float",
    "enableFloatHighlight": true,
    "currentFunctionSymbolAutoUpdate": true
  },
  // ---- list / explorer / source ----
  "list": {
    "nextKeymap": "<C-j>",
    "previousKeymap": "<C-k>",
    "extendedSearchMode": true,
    "insertMappings": {
      "<C-n>": "off",
      "<C-p>": "off",
      "<C-j>": "normal:j",
      "<C-k>": "normal:k"
    },
    "normalMappings": {
      "<C-n>": "off",
      "<C-p>": "off",
      "<C-j>": "normal:next",
      "<C-k>": "normal:previous"
    }
  },
  "explorer.icon.source": "vim-devicons",
  "coc.source.file.triggerCharacters": ["/"],
  "coc.source.buffer.disableSyntaxes": [],
  // ---- 浮窗 ----
  "signature.target": "float",
  "signature.floatConfig": {
    "border": true,
    "rounded": false,
    "highlight": "Normal",
    "maxWidth": 100,
    "focusable": false,
    "winblend": 0
  },
  "hover.floatConfig": {
    "border": true,
    "rounded": true,
    "highlight": "Normal",
    "maxWidth": 100,
    "focusable": false,
    "winblend": 0
  },
  "dialog.floatHighlight": "Normal",
  "dialog.floatBorderHighlight": "Normal",
  // ---- codeLens / inlayHint / git ----
  "codeLens.separator": "#",
  "codeLens.enable": true,
  "codeLens.display": true,
  "inlayHint.enable": false,
  "git.enableGutters": false,
  "git.realtimeGutters": false,
  // ---- 诊断 ----
  "diagnostic.enable": true,
  "diagnostic.displayByAle": false,
  "diagnostic.errorSign": "x",
  "diagnostic.warningSign": "!",
  "diagnostic.infoSign": ">",
  "diagnostic.hintSign": "-",
  "diagnostic.messageTarget": "float",
  "diagnostic.signPriority": 5,
  "diagnostic.enableHighlightLineNumber": false,
  "diagnostic.locationlistUpdate": false,
  "diagnostic.virtualText": false,
  "diagnostic.virtualTextCurrentLineOnly": true,
  "diagnostic.displayByVimDiagnostic": false,
  "diagnostic.floatConfig": {
    "border": true,
    "rounded": true,
    "highlight": "Normal",
    "maxWidth": 100,
    "focusable": false,
    "winblend": 0
  },
  // ---- snippets ----
  "snippets.ultisnips.enable": false,
  "snippets.loadFromExtensions": true,
  "snippets.enableStatusItem": false,
  "snippets.snipmate.enable": false,
  "snippets.shortcut": "SP",
  "snippets.extends": {
    "cpp": [
      "c"
    ],
    "typescript": [
      "javascript"
    ]
  },
  // ---- 补全 ----
  "suggest.enablePreselect": true,
  "suggest.noselect": true,
  "suggest.defaultSortMethod": "none",
  "suggest.snippetIndicator": "",
  "suggest.languageSourcePriority": 99,
  "suggest.triggerCompletionWait": 50,
  "suggest.acceptSuggestionOnCommitCharacter": true,
  "suggest.labelMaxLength": 48,
  "suggest.floatEnable": true,
  "suggest.floatConfig": {
    "winblend": 0
  },
  // ---- color ---- 
  "colors.enable": true,
  "semanticTokens.enable": true,
  "semanticTokens.filetypes": ["*"],
  // ============ 各语言 ============
  // ---- c/cpp/java/rust/ts/js: codeLens 分隔符 ----
  "[c][cpp][java][rust][typescript][javascript]": {
    "codeLens.separator": "//"
  },
  // ---- dockerfile ----
  "languageserver": {
    "dockerfile": {
      "command": "docker-langserver",
      "filetypes": [
        "dockerfile"
      ],
      "args": [
        "--stdio"
      ]
    }
  },
  // ---- python ----
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.typeCheckingMode": "off",
  "python.linting.pylintEnabled": false,
  "python.linting.flake8Enabled": true,
  "python.venvPath": [".venv", "venv", "../.venv", "../venv"],
  // ---- java ----
  "java.enabled": true,
  "java.codeGeneration.useBlocks": true,
  "java.import.maven.enabled": true,
  "java.maven.downloadSources": false,
  "java.trace.server": "off",
  // ---- go ----
  "go.trace.server": "off",
  "go.goplsPath": "gopls",
  "go.goplsUseDaemon": false,
  "go.goplsOptions": {
    "usePlaceholders": true,
    "semanticTokens": true
  },
  // ---- rust ----
  "rust-analyzer.trace.server": "off",
  "rust-analyzer.server.path": "rust-analyzer",
  // ---- typescript / javascript ----
  "typescript.autoClosingTags": false,
  "tsserver.trace.server": "off",
  "eslint.packageManager": "yarn",
  "eslint.run": "onSave",
  // ---- web: json / xml / html / css ----
  "json.trace.server": "off",
  "xml.trace.server": "off",
  "html.trace.server": "off",
  "css.trace.server": "off",
  // ---- yaml ----
  "yaml.trace.server": "off",
  "yaml.validate": true,
  "yaml.format.singleQuote": true,
  "yaml.completion": true,
  // ---- vim ----
  // "vimls.command": "~/.leovim.d/coc/extensions/coc-vimls-data/server-LyZZYV/vimls",
  "vimlsp.trace.server": "off",
  // ---- lua ----
  "lua.colors.enable": true
}
