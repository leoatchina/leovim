{
  "configurations": {
    "go-file": {
      "adapter": "delve",
      "filetypes": [ "go" ],
      "breakpoints": {
        "exception": {
          "unrecovered-panic": "",
          "runtime-fatal-throw": ""
        }
      },
      "configuration": {
        "name": "Go: Launch File",
        "type": "go",
        "request": "launch",
        "mode": "debug",
        "stopOnEntry": false,
        "cwd": "${fileDirname}",
        "program": "${file}",
        "args": []
      }
    }
  }
}
